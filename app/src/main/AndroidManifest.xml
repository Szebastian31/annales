<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for the weather: the same free Open-Meteo forecast Consensus Weather uses. Nothing about you is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The evening reminder ("Today is still unsealed"), and putting it back after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ hides other apps unless they are named here: the siblings Annales reads from or opens. -->
    <queries>
        <!-- a camera app, for "Take a photo" -->
        <intent><action android:name="android.media.action.IMAGE_CAPTURE" /></intent>
        <package android:name="com.fidelis.player" />
        <package android:name="com.kalendae.money" />
        <package android:name="com.augur.stars" />
        <package android:name="com.consensus.weather" />
        <package android:name="com.caelum.sky" />
        <provider android:authorities="com.fidelis.player.annales" />
        <provider android:authorities="com.kalendae.money.annales" />
        <provider android:authorities="com.augur.stars.annales" />
    </queries>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Only when you tap "Use where I am now": the town for a stamp's postmark. Approximate is enough; nothing is stored but the town. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Annales">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".reminder.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminder.BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Hands the camera app a file to save a new photo into. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.annales.journal.camera"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/camera_paths" />
        </provider>
    </application>
</manifest>
